# Deployer credentials. Never commit this file — .gitignore already excludes it.

# The wallet that pays for and owns the deploy. It becomes the program's upgrade
# authority (until you finalize, see README). Either a base58 string (as exported
# by Phantom/Solflare) or the JSON byte array from a `solana-keygen` keyfile.
# Must be the full 64-byte secret key, not a 32-byte seed.
DEPLOYER_PRIVATE_KEY=

# Devnet goes first. The public endpoint is usually fine for devnet.
DEVNET_RPC_URL=https://api.devnet.solana.com

# Mainnet. Use a private RPC — the public endpoint rate-limits program deploys and
# they tend to die partway through.
MAINNET_RPC_URL=
